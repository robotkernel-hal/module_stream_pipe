requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_stream_pipe_base
#     (optional) path to module_stream_pipe base directory
#     e.g. /volume/software/robotkernel/packages/module_stream_pipe/3.0.1
#     defaults to rmpm structure
#   module_stream_pipe_libdir
#     (optional) add custom module search paths
#   module_stream_pipe_mds
#     (optional) add custom message definition paths

defines
module_stream_pipe_base: %(dirname %(dirname %(CURDIR)))
module_stream_pipe_base_type: %(ifexists "%(module_stream_pipe_base)/lib/libmodule_stream_pipe.so", "local_install", "rmpm_release")
module_stream_pipe_libdir: %(ifeq "%(module_stream_pipe_base_type)", "local_install", "%(module_stream_pipe_base)/lib", "%(module_stream_pipe_base)/lib/$(ARCH)")

ifndef rk_modules: rk_modules: ""
rk_modules: %(rk_modules):%(module_stream_pipe_libdir)

