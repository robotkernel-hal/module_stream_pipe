requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_tcp_base
#     (optional) path to module_tcp base directory
#     e.g. /volume/software/robotkernel/packages/module_tcp/3.0.1
#     defaults to rmpm structure
#   module_tcp_libdir
#     (optional) add custom module search paths
#   module_tcp_mds
#     (optional) add custom message definition paths

defines
module_tcp_base: %(dirname %(dirname %(CURDIR)))
module_tcp_base_type: %(ifexists "%(module_tcp_base)/lib/libmodule_tcp.so", "local_install", "rmpm_release")
warning: "module_tcp_base_type: %(module_tcp_base_type)"
module_tcp_libdir: %(ifeq "%(module_tcp_base_type)", "local_install", "%(module_tcp_base)/lib", "%(module_tcp_base)/lib/$(ARCH)")

ifndef rk_modules: rk_modules: ""
rk_modules: %(rk_modules):%(module_tcp_libdir)

