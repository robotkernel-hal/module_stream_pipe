PTVERSION           = 2
NAME                = @PACKAGE@
VERSION             = @PACKAGE_VERSION@
DESCRIPTION         = robotkernel stream pipe module
MAINTAINER          = Florian Schmidt <florian.schmidt@dlr.de>
DOCUMENTATION       = https://rmintra01.robotic.dlr.de/wiki/Robotkernel/module_stream_pipe
ARCHS               = sled11-x86-gcc4.x, sled11-x86_64-gcc4.x, ubuntu12.04-armhf-gcc4.x

[install]
build/${ARCH}/install/lib => lib/${ARCH}
doc/ => doc/
share/ => share/

